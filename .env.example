# Copy to .env and fill in the five values. Same names as the GitHub secrets
# in step 9. Load with:  set -a; source .env; set +a
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Derived. Terraform reads TF_VAR_*, the s3 backend reads AWS_*, Wrangler
# reads CLOUDFLARE_*. Nothing below needs editing.
TF_VAR_cloudflare_account_id=$CLOUDFLARE_ACCOUNT_ID
TF_VAR_cloudflare_zone_id=$CLOUDFLARE_ZONE_ID
TF_VAR_cloudflare_api_token=$CLOUDFLARE_API_TOKEN
AWS_ENDPOINT_URL_S3=https://$CLOUDFLARE_ACCOUNT_ID.r2.cloudflarestorage.com
AWS_ACCESS_KEY_ID=$R2_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=$R2_SECRET_ACCESS_KEY
AWS_REGION=auto
